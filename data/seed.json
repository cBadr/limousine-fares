  "notes": [
    {
      "id": "n_662b2abb",
      "text": "في حالة بداية اليومية من العاصمة الادارية والعاشر ومدينه بدر وحلوان تزيد 200ج"
    },
    {
      "id": "n_13eead99",
      "text": "في حالة بداية اليومية من مدينتي او أكتوبر او الشروق تزيد 100 ج"
    },
    {
      "id": "n_b78935bd",
      "text": "في حالة بداية اليومية من المطار او النهاية في المطار تزيد 100ج"
    },
    {
      "id": "n_9b173874",
      "text": "عدد ساعات الإنتظار في الذهاب والعوده ثلاث ساعات فقط والساعه الزياده الثابته 100 ج والمتحركة 150 ج"
    },
    {
      "id": "n_81455b93",
      "text": "اليوميات الكيلو متر بالإتفاق بين الطرفين وأى كيلو زياده يحسب 7 جنيهات"
    },
    {
      "id": "n_9a581871",
      "text": "في حالة طلب جلورى او إكسباندر بشبكة في التوصيله تزيد 50 ج - في السخنه والساحل وإسكندريه تزيد 100 ج - شرم الشيخ والغردقه ومطروح وما يعادلها تزيد 200 ج"
    },
    {
      "id": "n_6e6764d6",
      "text": "في حالة وجود أوفر داى يتم زيادة 700 ج على الذهاب والعوده ( 8 ساعات مع تحركات ) وفى حالة عدم التحرك تحسب ساعات زيادة بعد الثلاث الساعات الإنتظار للذهاب واالعوده"
    },
    {
      "id": "n_a72b4260",
      "text": "اليوميه تحسب بعد ال 9 ساعات يوميه 12 ساعه"
    }
  ]
